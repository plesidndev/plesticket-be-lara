            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Band\",\n  \"slug\": \"postman-band\",\n  \"type\": \"group\",\n  \"category\": \"band\",\n  \"genre\": \"Pop\",\n  \"bio\": \"Demo talent created from Postman.\",\n  \"origin_city\": \"Jakarta\",\n  \"contact_name\": \"Demo Manager\",\n  \"contact_phone\": \"081234567890\",\n  \"contact_email\": \"manager@example.com\",\n  \"instagram\": \"postmanband\"\n}"
            },
            "url": "{{base_url}}/talents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('talent_id', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Talent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated from Postman.\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/talents/{{talent_id}}"
          }
        },
        {
          "name": "Delete Talent",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/talents/{{talent_id}}"
          }
        },
        {
          "name": "List Event Lineup",
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events/{{event_id}}/talents"
          }
        },
        {
          "name": "Add Talent to Lineup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"talent_id\": {{talent_id}},\n  \"role\": \"headliner\",\n  \"performance_order\": 1,\n  \"performance_time\": \"20:00\"\n}"
            },
            "url": "{{base_url}}/events/{{event_id}}/talents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set('lineup_id', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Lineup Entry",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"performer\",\n  \"performance_order\": 2,\n  \"performance_time\": \"18:00\"\n}"
            },
            "url": "{{base_url}}/events/{{event_id}}/talents/{{lineup_id}}"
          }
        },
        {
          "name": "Delete Lineup Entry",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/events/{{event_id}}/talents/{{lineup_id}}"
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Show Ticket",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tickets/{{ticket_code}}"
          }
        },
        {
          "name": "Scan Ticket",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{organizer_token}}",
                "type": "string"
              }
            ]
          },
          "request": {
            "method": "POST",
            "url": "{{base_url}}/tickets/{{ticket_code}}/scan"
          }
        }
      ]
    },
    {
      "name": "Ticket Agent Portal",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{organizer_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Agent Event",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agent/event"
          }
        },
        {
          "name": "Agent Event Ticket Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agent/event/ticket-types"
          }
        },
        {
          "name": "Agent Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agent/orders?limit=15&search="
          }
        },
        {
          "name": "Create Agent Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer_name\": \"Walk-in Buyer\",\n  \"buyer_phone\": \"081234567890\",\n  \"items\": [{\n    \"ticket_type_id\": {{ticket_type_id}},\n    \"quantity\": 1\n  }]\n}"
            },
            "url": "{{base_url}}/agent/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.order_number) pm.collectionVariables.set('order_number', json.data.order_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Agent Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agent/orders/{{order_number}}"
          }
        },
        {
          "name": "Agent Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agent/summary"
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Xendit Payment Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-callback-token",
                "value": "{{xendit_callback_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.succeeded\",\n  \"data\": {\n    \"id\": \"ps_test_1\",\n    \"payment_request_id\": \"pr_test_1\",\n    \"reference_id\": \"{{payment_reference}}\",\n    \"amount\": {{payment_amount}},\n    \"status\": \"SUCCEEDED\",\n    \"created\": \"2026-08-26T12:00:00+07:00\"\n  }\n}"
            },
            "url": "{{base_url}}/webhooks/xendit",
            "description": "Simulates a Xendit callback locally. Run Create Order (with payment_method) or Create QRIS Payment first so payment_reference and payment_amount are set, and put your XENDIT_CALLBACK_TOKEN into the xendit_callback_token variable.\n\namount must match the payment exactly - a lower value trips the underpayment guard, which marks the payment failed and issues no tickets."
          }
        }
      ]
    }
  ]
}
