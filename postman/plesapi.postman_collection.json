    {
      "name": "Buyer Orders & Payments",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders?limit=15"
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{event_id}}\",\n  \"payment_method\": \"qris\",\n  \"items\": [{\n    \"ticket_type_id\": {{ticket_type_id}},\n    \"quantity\": 1\n  }]\n}"
            },
            "url": "{{base_url}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "const order = data.order || data;",
                  "if (order.order_number) pm.collectionVariables.set('order_number', order.order_number);",
                  "if (data.payment) {",
                  "  if (data.payment.reference_id) pm.collectionVariables.set('payment_reference', data.payment.reference_id);",
                  "  if (data.payment.amount) pm.collectionVariables.set('payment_amount', data.payment.amount);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_number}}"
          }
        },
        {
          "name": "Direct Pay Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"cash\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_number}}/pay"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/{{order_number}}/cancel"
          }
        },
        {
          "name": "Create QRIS Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method_code\": \"qris\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_number}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.reference_id) pm.collectionVariables.set('payment_reference', data.reference_id);",
                  "// Keep the webhook amount in step: a mismatch trips the underpayment guard,",
                  "// which fails the payment and issues no tickets.",
                  "if (data.amount) pm.collectionVariables.set('payment_amount', data.amount);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Payment",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_number}}/payments"
          }
        }
      ]
    },
