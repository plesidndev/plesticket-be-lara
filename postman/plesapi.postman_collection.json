        {
          "name": "Activate Organizer Access",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{platform_token}}",
                "type": "string"
              }
            ]
          },
          "request": {
            "method": "POST",
            "url": "{{base_url}}/eo/activate",
            "description": "Turns the signed-in account into an event organizer. Idempotent.\n\nReturns a replacement token and the test script swaps it in, but that is cosmetic: the `eo` middleware reads is_organizer from the database, so the token you already hold authorizes EO routes immediately. The swap only keeps a client that decodes the JWT from seeing a stale is_organizer:false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "// Swap in the replacement token, or EO routes keep returning 403.",
                  "if (json.data && json.data.token) pm.collectionVariables.set('platform_token', json.data.token);"
                ]
              }
            }
          ]
        }
      ],
      "description": "One users table, one login endpoint, shared by both frontends. is_organizer is a flag, not a role - the same account can organise events and buy tickets to someone else's. Run 'Activate Organizer Access' to set it. It returns a replacement token (swapped in automatically), though the previous token also keeps working - the gate checks the database, not the JWT claim."
    },
    {
      "name": "Buyer App",
      "item": [
        {
          "name": "Orders & Payments",
          "item": [
            {
              "name": "List Orders",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/orders?limit=15"
              }
            },
            {
              "name": "Create Order",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"event_id\": \"{{event_id}}\",\n  \"payment_method\": \"qris\",\n  \"items\": [{\n    \"ticket_type_id\": {{ticket_type_id}},\n    \"quantity\": 1\n  }]\n}"
                },
                "url": "{{base_url}}/orders",
                "description": "Creating an order reserves ticket quota immediately and holds it for 30 minutes. Leave it unpaid and the orders:expire sweeper releases the seats.\n\npayment_method is optional - include it to create the order and its charge in one call, or omit it and use 'Create QRIS Payment' separately."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || {};",
                      "const order = data.order || data;",
                      "if (order.order_number) pm.collectionVariables.set('order_number', order.order_number);",
                      "if (data.payment) {",
                      "  if (data.payment.reference_id) pm.collectionVariables.set('payment_reference', data.payment.reference_id);",
                      "  if (data.payment.amount) pm.collectionVariables.set('payment_amount', data.payment.amount);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Show Order",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/orders/{{order_number}}"
              }
            },
            {
              "name": "Direct Pay Order",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"payment_method\": \"cash\"\n}"
                },
                "url": "{{base_url}}/orders/{{order_number}}/pay"
              }
            },
            {
              "name": "Cancel Order",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/orders/{{order_number}}/cancel"
              }
            },
            {
              "name": "Create QRIS Payment",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method_code\": \"qris\"\n}"
                },
                "url": "{{base_url}}/orders/{{order_number}}/payments"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const data = json.data || {};",
                      "if (data.reference_id) pm.collectionVariables.set('payment_reference', data.reference_id);",
                      "// Keep the webhook amount in step: a mismatch trips the underpayment guard,",
                      "// which fails the payment and issues no tickets.",
                      "if (data.amount) pm.collectionVariables.set('payment_amount', data.amount);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get Current Payment",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/orders/{{order_number}}/payments"
              }
            }
          ]
        },
        {
          "name": "Tickets",
          "item": [
            {
              "name": "Show Ticket",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/tickets/{{ticket_code}}"
              }
            }
          ]
        }
      ],
      "description": "The ticket-buying frontend. Plain auth:api - no EO privileges needed, and a buyer account never touches anything in the EO App folder."
    },
